# 複製成 .env（.env 已被 .gitignore 排除，不會進 git）：
#   cp .env.example .env  然後填入下面的值
# 本機 / cron 執行會自動讀取 .env；GitHub Actions 改用 repo Secrets 注入。

# Telegram bot token（跟 @BotFather 傳 /newbot 取得）
TELEGRAM_BOT_TOKEN=

# 你的 Telegram 數字 chat id（bot 只回應這個 id）
TELEGRAM_CHAT_ID=

# RapidAPI 的 JSearch API key
RAPIDAPI_KEY=

# Claude Code 訂閱用的長效 token。
# 先安裝 CLI：npm install -g @anthropic-ai/claude-code
# 再跑：claude setup-token   把印出來的值貼在這裡
CLAUDE_CODE_OAUTH_TOKEN=

# 選填：指定模型，例如 claude-sonnet-5（預設用訂閱的預設模型）
CLAUDE_MODEL=

# 選填：claude 執行檔路徑（預設 "claude"）
# CLAUDE_BIN=claude
