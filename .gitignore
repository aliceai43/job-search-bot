# ── 秘密 / 憑證 ───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
/secrets/

# ── 個人資料：履歷、求職需求、履歷編修歷史備份 ────────────────
/profile/resume.txt
/profile/preferences.txt
/profile/history/*
!/profile/history/.gitkeep

# ── 個人文件檔：避免把測試用的履歷檔不小心 commit 進來 ──────────
*.pdf
*.doc
*.docx
*.odt
*.rtf

# ── 執行狀態：含職缺歷史、Telegram chat id、履歷對話紀錄 ──────
/state/*.json
!/state/.gitkeep

# ── 個人搜尋設定（含 visa_status / 地點）：用 config.example.json 當範本 ──
/config.json
!/config.example.json

# ── data_sync.sh 從私有 data repo clone 下來的暫存目錄 ──────
/_data/

# ── Node（claude CLI 建議用 -g 全域安裝，但以防萬一）──────────
node_modules/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ── 本機產物 / 暫存 ─────────────────────────────────────────
*.log
scratch/
*.bak
*.tmp

# ── OS / 編輯器 ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*~
